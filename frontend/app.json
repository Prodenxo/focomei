{
  "expo": {
    "name": "FocoMEI",
    "slug": "focomei-web",
    "version": "2.2.7",
    "orientation": "default",
    "icon": "./assets/brand-mark.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand-mark.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0D2B5E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "financas-pessoais",
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "meiApiUrl": ""
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production",
            "default": false
          }
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
